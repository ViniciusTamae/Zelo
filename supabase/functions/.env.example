# Copie para supabase/functions/.env (Supabase local). Na nuvem, use
# `supabase secrets set NOME=valor` para cada um.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br
# Segredo que o banco (pg_net/pg_cron) manda para a função entregar-notificacoes.
# O mesmo valor fica no Vault do banco (ver README).
NOTIFICACOES_SEGREDO=

# E-mails ao inquilino (mudança de status e pesquisa de satisfação).
# Endereço público do app (vai nos links dos e-mails).
APP_URL=https://seudominio.com.br
RESEND_FROM=Zelo <avisos@seudominio.com.br>
# Produção: RESEND_API_KEY. Local: sem ela, os e-mails vão para o Mailpit.
# RESEND_API_KEY=
MAILPIT_URL=http://supabase_inbucket_zelo:8025
