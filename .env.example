# Copie para .env.local e preencha. Nunca versione .env.local.
# Local: os valores aparecem em `make db-status`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). Só no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública do app (usada para montar o link do inquilino /c/[token])
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mails que o app manda (ex.: "Perdi meu link" do inquilino).
# Produção: Resend (domínio verificado). Sem RESEND_API_KEY, vai para o
# Mailpit do Supabase local (http://localhost:54324), que só guarda para teste.
# RESEND_API_KEY=
RESEND_FROM="Zelo <avisos@seudominio.com.br>"
MAILPIT_URL=http://127.0.0.1:54324


# Web Push do proprietário: só a chave PÚBLICA fica no app. A privada, o
# assunto e o segredo das notificações ficam na Edge Function
# (supabase/functions/.env no local; `supabase secrets set` na nuvem).
# Gerar o par: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
