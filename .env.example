# Copie para .env.local e preencha. Nunca versione .env.local.
# Local: os valores aparecem em `make db-status`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). Só no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública do app (usada para montar o link do inquilino /c/[token])
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Próximas tarefas (ainda não usadas) ---
# E-mail ao inquilino (Resend)
# RESEND_API_KEY=
# RESEND_FROM="Zelo <avisos@seudominio.com.br>"

# Web Push do proprietário (gerar com: pnpm dlx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@seudominio.com.br
