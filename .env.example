# Copie para .env.local e preencha. Nunca versione .env.local.
# Local: os valores aparecem em `make db-status`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). Só no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública do app (usada para montar o link do inquilino /c/[token])
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mails que o app manda (ex.: "Perdi meu link" do inquilino), pelo primeiro
# caminho configurado: SMTP (ex.: Gmail com senha de app, porta 465), Resend
# (domínio verificado) ou, no local, o Mailpit do Supabase
# (http://localhost:54324), que só guarda para teste.
EMAIL_FROM="Zelo <avisos@seudominio.com.br>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=voce@gmail.com
# SMTP_PASS=senha-de-app
# RESEND_API_KEY=
MAILPIT_URL=http://127.0.0.1:54324


# Web Push do proprietário: só a chave PÚBLICA fica no app. A privada, o
# assunto e o segredo das notificações ficam na Edge Function
# (supabase/functions/.env no local; `supabase secrets set` na nuvem).
# Gerar o par: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Só na demonstração da Vercel: mostra "Entrar na demonstração" em /entrar.
# Cada clique cria uma conta de visitante, já com os dados de exemplo; a
# rota /api/demonstracao/limpar (Vercel Cron, com CRON_SECRET) apaga as contas
# com mais de 24 h. Nunca ligue numa produção de verdade.
# DEMONSTRACAO=ligada
# CRON_SECRET=
